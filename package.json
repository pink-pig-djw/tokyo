{
  "name": "tokyo-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Real-data 3D panoramic tour of central Tokyo (Three.js + Overture Maps)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
